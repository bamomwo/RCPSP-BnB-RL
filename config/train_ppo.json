{
  "root": "data/train/1kNetRes",
  "pattern": "*.rcp",
  "max_instances": null,
  "resource_encoder": "set",
  "dominance": "set_based",

  "bc_checkpoint": "models/policy_bc.pt",
  "d_model": 64,
  "n_heads": 4,
  "n_layers": 2,
  "ffn_dim": 128,
  "dropout": 0.0,

  "total_env_steps": 30000000,
  "ppo_epochs": 4,
  "target_mb_size": 2048,
  "clip_eps": 0.2,
  "tree_gamma": 1.0,
  "tree_gae_lambda": 0.95,
  "advantage_space": "log",
  "min_batch_size": 16384,
  "min_episodes": 8,
  "episode_transition_cap": 4096,
  "forced_state_cap": 1024,
  "actor_closed_only": true,
  "stratify_time_bands": 3,
  "stratify_depth_bands": 4,
  "shallow_depth_threshold": 0.5,
  "shallow_priority_per_cell": 256,
  "ent_coef_start": 0.002,
  "ent_coef_end": 0.0005,
  "vf_coef": 0.5,
  "vf_loss_type": "mse",
  "actor_lr": 5e-5,
  "critic_lr": 3e-4,
  "critic_warmup_updates": 16,
  "max_grad_norm": 0.5,
  "target_kl": 0.03,
  "time_limit_s": 1500.0,
  "max_nodes": 200000,

  "eval_every_updates": 1,
  "eval_root": "data/eval/intrain/J30_10",
  "eval_pattern": "*.rcp",
  "eval_time_limit_s": 60.0,
  "eval_optimal_json": "data/baseline/j30_opt.json",

  "save_path": "models/td/policy_ppo.pt",
  "checkpoint_dir": "models/td/checkpoints",
  "tensorboard": true,
  "seed": 42,
  "device": "cuda"
}
