{
  "data_csv": "data/estimator/data-480/data_all.csv",
  "val_frac": 0.2,
  "stratify_split": true,

  "hidden1": 256,
  "hidden2": 128,
  "dropout": 0.2,
  "negative_slope": 0.01,

  "band_lo": 0.7,
  "band_hi": 1.5,
  "w_under": 1.0,
  "w_over": 1.0,
  "c_target": 1.0,
  "weight_by_target": false,

  "lr": 1e-3,
  "weight_decay": 1e-4,
  "batch_size": 128,
  "epochs": 300,
  "patience": 30,
  "min_epochs": 20,

  "save_path": "models/estimator/estimator.pt",
  "seed": 42,
  "device": "cpu"
}
