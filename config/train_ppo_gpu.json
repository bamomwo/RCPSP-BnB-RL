{
  "root": "data/train/1kNetRes",
  "pattern": "*.rcp",
  "max_instances": null,
  "max_resources": 4,
  "dominance": "set_based",

  "bc_checkpoint": "models/policy_bc.pt",
  "d_model": 64,
  "n_heads": 4,
  "n_layers": 2,
  "ffn_dim": 128,
  "dropout": 0.0,

  "total_env_steps": 10000000,
  "ppo_epochs": 4,
  "minibatches": 8,
  "clip_eps": 0.2,
  "tree_gamma_cost": 0.85,
  "tree_gamma_bonus": 1.0,
  "tree_keep_open": false,
  "min_batch_size": 16384,
  "ent_coef_start": 0.002,
  "ent_coef_end": 0.0005,
  "vf_coef": 0.5,
  "vf_loss_type": "huber",
  "huber_delta": 3.0,
  "lr": 1e-4,
  "max_grad_norm": 0.5,
  "target_kl": 0.05,
  "time_limit_s": 480.0,

  "alpha": 0.001,
  "beta1": 1.0,
  "beta2": 1.0,

  "estimator_path": "models/estimator/estimator.pt",
  "c_target": 1.0,
  "alpha_min": 1e-6,
  "alpha_max": 0.5,

  "eval_every_steps": 200000,
  "eval_root": "data/eval/J30/J30_10",
  "eval_pattern": "*.RCP",
  "eval_time_limit_s": 60.0,
  "eval_optimal_json": "data/baseline/j30_opt.json",

  "save_path": "models/train/policy_ppo.pt",
  "checkpoint_dir": "models/train/checkpoints",
  "seed": 42,
  "device": "cuda"
}
