{
  "root": "data/train/1kNetRes",
  "pattern": "*.rcp",
  "max_instances": null,
  "max_resources": 4,
  "dominance": "set_based",

  "bc_checkpoint": "models/best/policy_ppo_1_1.pt",
  "d_model": 64,
  "n_heads": 4,
  "n_layers": 2,
  "ffn_dim": 128,
  "dropout": 0.0,

  "total_env_steps": 5000000,
  "ppo_epochs": 4,
  "minibatches": 8,
  "clip_eps": 0.2,
  "tree_gamma_cost": 0.85,
  "tree_gamma_bonus": 1.0,
  "tree_keep_open": false,
  "min_batch_size": 4096,
  "ent_coef_start": 0.002,
  "ent_coef_end": 0.0001,
  "vf_coef": 0.5,
  "lr": 1e-3,
  "max_grad_norm": 0.5,
  "target_kl": 0.05,
  "time_limit_s": 120.0,

  "alpha": 0.01,
  "beta1": 1.0,
  "beta2": 1.0,

  "eval_every_steps": 400000,
  "eval_root": "data/eval/J30/J30_10",
  "eval_pattern": "*.RCP",
  "eval_time_limit_s": 60.0,
  "eval_optimal_json": "data/baseline/j30_opt.json",

  "save_path": "models/train_1_2/policy_ppo.pt",
  "checkpoint_dir": "models/train_1_2/checkpoints",
  "seed": 82,
  "device": "cuda"
}
